{
  "name": "waptia-admin",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "./web",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "admin.waptia.infortts.site", "custom_domain": true },
    { "pattern": "admin.waptia.infortts.com", "custom_domain": true }
  ]
}
