# Infortts canonical Android lane — generated by jenkins/generate-jenkinsfiles.sh.
# Makes the Jenkins Play upload (`fastlane internal`) behave identically for every app.
# Lane reads PACKAGE / TRACK / PLAY_SA_JSON from the environment (Jenkins injects them);
# falls back to the Appfile package, 'internal' track, and the local deploy keys for manual runs.

default_platform(:android)

def app_package
  pkg = (ENV['PACKAGE'] || '').strip
  return pkg unless pkg.empty?
  begin
    require 'credentials_manager'
    ap = CredentialsManager::AppfileConfig.try_fetch_value(:package_name)
    return ap if ap && !ap.empty?
  rescue => _
  end
  nil
end

def app_track
  track = (ENV['TRACK'] || '').strip
  track.empty? ? 'internal' : track
end

def service_account_key
  env_key = (ENV['PLAY_SA_JSON'] || '').strip
  return env_key if !env_key.empty? && File.exist?(env_key)
  [
    File.expand_path('~/Downloads/infortts-mobile-deployment-key.json'),
    File.expand_path('~/Downloads/infortts-57f65b1569af.json')
  ].find { |p| File.exist?(p) }
end

platform :android do
  desc 'Build (if needed) and upload the release AAB to the Google Play Internal track'
  lane :internal do
    aab_path = File.expand_path('../build/app/outputs/bundle/release/app-release.aab', __dir__)

    package = app_package
    UI.user_error!('No Play package: set PACKAGE env or Appfile package_name') if package.nil?

    key = service_account_key
    UI.user_error!('No Play service-account JSON: set PLAY_SA_JSON env or place infortts deploy key in ~/Downloads') if key.nil?

    unless File.exist?(aab_path)
      UI.message("AAB not found at #{aab_path} — building release appbundle ...")
      sh('flutter', 'build', 'appbundle', '--release')
    end

    track = app_track
    UI.message("Uploading #{package} to Google Play #{track} track ...")
    upload_to_play_store(
      package_name: package,
      track: track,
      json_key: key,
      aab: aab_path,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: 'completed'
    )
    UI.message("Successfully deployed #{package} to Google Play #{track} track")
  end
end